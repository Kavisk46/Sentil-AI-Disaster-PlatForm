# Copy this file to .env.local and adjust for your environment.

# Base URL of the SentinelAI backend API (see apps/api/.env.example).
NEXT_PUBLIC_API_URL=http://localhost:8000

# MapLibre GL JS style URL for the command-center map (Milestone 8). Optional
# — defaults to MapLibre's own free "demotiles" style (no API key required)
# when unset. Point this at a real tile provider's style.json for richer
# production cartography. See docs/architecture/frontend.md, "Map technology".
# NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
