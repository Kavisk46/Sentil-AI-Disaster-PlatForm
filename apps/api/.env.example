# Copy this file to .env and adjust values for your environment.
# See app/core/config.py for how these are loaded and validated.

# Application metadata
APP_NAME="SentinelAI API"
APP_DESCRIPTION="Backend API for SentinelAI — an AI-powered disaster intelligence platform."
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

# Networking
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Image ingestion (Milestone 2). Local, gitignored, development-only
# directory — resolved relative to the working directory the API is
# started from (apps/api, per the run command in README.md).
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10
