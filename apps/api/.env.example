# Copy this file to .env and adjust values for your environment.
# See app/core/config.py for how these are loaded and validated.

# Application metadata
APP_NAME="SentinelAI API"
APP_DESCRIPTION="Backend API for SentinelAI — an AI-powered disaster intelligence platform."
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true

# Networking
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call this API from a browser.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO

# Image ingestion (Milestone 2). Local, gitignored, development-only
# directory — resolved relative to the working directory the API is
# started from (apps/api, per the run command in README.md).
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Damage-intelligence model (Milestone F4 — real inference, CPU-only).
# Defaults (all commented out below) already enable real zero-shot damage
# classification via a genuine pretrained CLIP checkpoint, downloaded once
# on first use and cached — no GPU, no training, no fine-tuning required.
# See apps/api/README.md, "Milestone F4 — real inference", for the full
# honesty disclosure (this is a general-purpose model, NOT trained on
# xBD) and confidence interpretation.
# MODEL_ENABLED=true
# MODEL_PROVIDER=open_clip
# MODEL_NAME=ViT-B-32
# MODEL_VERSION=openai
MODEL_DEVICE=cpu
# MODEL_MAX_IMAGE_DIM=4096
# MODEL_TILE_GRID=2
#
# Set MODEL_ENABLED=false to disable real inference entirely (every
# analysis then ends MODEL_UNAVAILABLE, honestly) — e.g. for an
# offline/no-network environment.
#
# MODEL_PROVIDER=legacy_resnet restores Milestone 3A/3C's original
# architecture (TorchDamageClassifier + UnavailableBuildingLocalizer),
# which requires an external fine-tuned checkpoint — set MODEL_PATH to
# it, and MODEL_NAME/MODEL_VERSION to describe that checkpoint instead.
# MODEL_PATH=

# Production infrastructure (Milestone F5). Defaults below match
# docker-compose.yml's `postgres`/`redis` services exactly — zero further
# configuration needed for `docker compose up`. See
# docs/architecture/production.md for the full architecture.
# DATABASE_URL=postgresql+psycopg://sentinelai:sentinelai@localhost:5432/sentinelai
# REDIS_URL=redis://localhost:6379/0
# OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_ROOT=storage/uploads
# WORKER_CONCURRENCY=1
# JOB_MAX_RETRIES=2
